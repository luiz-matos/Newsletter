# Copie para .env.local e preencha

# App OAuth do GitHub (Settings > Developer settings > OAuth Apps)
GITHUB_ID=
GITHUB_SECRET=

# Segredo do next-auth: gere com `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edunews

# Stripe (modo de teste)
STRIPE_API_KEY=
STRIPE_PRICE_ID=

# Segredo do webhook: aparece no `stripe listen` ou no painel do Stripe
STRIPE_WEBHOOK_SECRET=
