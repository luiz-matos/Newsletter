# Copie para .env.local e preencha

# App OAuth do GitHub (Settings > Developer settings > OAuth Apps)
GITHUB_ID=
GITHUB_SECRET=

# Segredo do next-auth: gere com `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Stripe (modo de teste)
STRIPE_API_KEY=
STRIPE_PRICE_ID=
